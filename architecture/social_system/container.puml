@startuml social_system
!include <C4/C4_Container>

Person(traveler, "Путешественник", "Подписывается, комментирует и ставит оценки")
Container(apiGateway, "API Gateway", "", "Единая точка входа: маршрутизация, аутентификация, rate limiting, балансировка")
ContainerQueue(kafka, "Events Queue", "Kafka", "Шина событий: подписки, комментарии и оценки для пересчёта лент и счётчиков")

System_Boundary(socialSystem, "Social") {
    Container(subscribe, "Subscribe Service", "", "Управление подписками/отписками между путешественниками; публикует события для перестроения лент")
    Container(reviews, "Reviews Service", "", "Комментарии и оценки постов и экскурсий; публикует события для пересчёта счётчиков и рейтингов")
    ContainerDb(socialDb, "Social DB", "PostgreSQL", "Хранилище графа подписок, комментариев и рейтингов")
}

Rel(traveler, apiGateway, "Подписки, комментарии, оценки", "REST/HTTPS")
Rel(apiGateway, subscribe, "POST /subscribe, /unsubscribe", "REST")
Rel(apiGateway, reviews, "POST /comments, /ratings", "REST")

Rel(subscribe, socialDb, "Сохраняет подписки")
Rel(subscribe, kafka, "Публикует события подписок", "Async")

Rel(reviews, socialDb, "Сохраняет комментарии и оценки")
Rel(reviews, kafka, "Публикует события отзывов и счётчиков", "Async")
@enduml
