@startuml
!include <C4/C4_Container>

Person(traveler, "Путешественник")
Container(apiGateway, "API Gateway", "Маршрутизация, аутентификация, балансировка")
ContainerQueue(kafka, "Events Queue", "Kafka", "События изменения экскурсий")
System(mediaSystem, "Media", "Обработка и хранение фотографий")

System_Boundary(excursionsSystem, "Excursions") {
    Container(excursionWrite, "Excursion Write Service", "Создание и редактирование экскурсий")
    Container(excursionRead, "Excursion Read Service", "Просмотр и поиск по каталогу")
    ContainerDb(excursionsDb, "Excursions DB", "PostgreSQL", "Экскурсии и метаданные")
    ContainerDb(catalogCache, "Catalog Cache", "Redis", "Кэш каталога")
    ContainerDb(excursionsSearch, "Excursions Search", "Elasticsearch", "Индекс экскурсий")
}

Rel(traveler, apiGateway, "REST")
Rel(apiGateway, excursionWrite, "POST /excursions", "REST")
Rel(apiGateway, excursionRead, "GET /excursions", "REST")

Rel(excursionWrite, excursionsDb, "Сохраняет экскурсии")
Rel(excursionWrite, mediaSystem, "Отправляет фото на обработку")
Rel(excursionWrite, kafka, "Публикует события экскурсий", "Async")

Rel(excursionRead, catalogCache, "Читает кэш каталога")
Rel(excursionRead, excursionsSearch, "Поиск экскурсий")
Rel(kafka, excursionRead, "Обновление каталога", "Async")
@enduml
