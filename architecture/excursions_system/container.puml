@startuml excursions_system
!include <C4/C4_Container>

Person(traveler, "Путешественник", "Создаёт, ищет и просматривает экскурсии")
Container(apiGateway, "API Gateway", "", "Единая точка входа: маршрутизация, аутентификация, rate limiting, балансировка")
ContainerQueue(kafka, "Events Queue", "Kafka", "Шина событий: изменения каталога экскурсий для обновления read-моделей")
System(mediaSystem, "Media", "Обрабатывает и хранит фотографии, возвращает CDN-ссылки")

System_Boundary(excursionsSystem, "Excursions") {
    Container(excursionWrite, "Excursion Write Service", "", "Создание и редактирование карточек экскурсий, сохраняет в БД и публикует события об изменениях каталога")
    Container(excursionRead, "Excursion Read Service", "", "Поиск и просмотр каталога по направлениям с рейтингом; читает из кэша и поискового индекса")
    ContainerDb(excursionsDb, "Excursions DB", "PostgreSQL", "Мастер-хранилище экскурсий и метаданных каталога")
    ContainerDb(catalogCache, "Catalog Cache", "Redis", "Кэш горячих карточек и выборок каталога")
    ContainerDb(excursionsSearch, "Excursions Search", "Elasticsearch", "Индекс экскурсий для поиска по направлениям и фильтрам")
}

Rel(traveler, apiGateway, "Работа с каталогом экскурсий", "REST/HTTPS")
Rel(apiGateway, excursionWrite, "POST /excursions", "REST")
Rel(apiGateway, excursionRead, "GET /excursions", "REST")

Rel(excursionWrite, excursionsDb, "Сохраняет экскурсии")
Rel(excursionWrite, mediaSystem, "Отправляет фото на обработку")
Rel(excursionWrite, kafka, "Публикует события экскурсий", "Async")

Rel(excursionRead, catalogCache, "Читает кэш каталога")
Rel(excursionRead, excursionsSearch, "Поиск экскурсий")
Rel(kafka, excursionRead, "События для обновления каталога", "Async")
@enduml
